<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
        <!-- 抑制警告 -->
        <NoWarn>$(NoWarn);CS9057;AVLN5001;CS8767</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia 核心包 -->
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />

        <!-- ReactiveUI 使用 11.1.0 版本（兼容 Avalonia 12） -->
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />

        <!-- 其他包 -->
        <PackageReference Include="EPPlus" Version="7.1.3" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.0-beta1" />       

        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.6" />
        <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.10" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.10" />

        <PackageReference Include="NPOI" Version="2.8.0" />
        <PackageReference Include="ProDataGrid" Version="12.0.4" />
        <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
    </ItemGroup>
</Project>