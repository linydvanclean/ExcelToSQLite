<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ExcelToSQLite.Views.UserManagementView">
    
    <Border Background="White"
            CornerRadius="10"
            Padding="40">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="15">
            <TextBlock Text="👤 用户管理"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="此功能正在开发中..."
                       FontSize="16"
                       Foreground="#7F8C8D"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="敬请期待"
                       FontSize="14"
                       Foreground="#95A5A6"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>