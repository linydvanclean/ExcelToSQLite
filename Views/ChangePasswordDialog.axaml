<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="420"
             x:Class="ExcelToSQLite.Views.ChangePasswordDialog">
    
    <UserControl.Styles>
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.PrimaryButton:pointerover">
            <Setter Property="Background" Value="#43A047"/>
        </Style>
        
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="#78909C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#607D8B"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- 密码文本框样式 - 限制宽度 -->
        <Style Selector="TextBox.PasswordInput">
            <Setter Property="Width" Value="220"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 密码强度指示器样式 -->
        <Style Selector="Border.StrengthIndicator">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Styles>

    <Border Background="White" 
            CornerRadius="12" 
            Padding="24"
            Width="460">
        <StackPanel Spacing="16">
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <TextBlock Text="🔐" FontSize="28" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="修改密码" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#1A237E"/>
                    <TextBlock Text="请填写当前密码和新密码" 
                               FontSize="13" 
                               Foreground="#78909C"
                               Opacity="0.8"/>
                </StackPanel>
            </StackPanel>

            <!-- 表单 -->
            <Border Background="#F8F9FA" 
                    CornerRadius="8" 
                    Padding="16"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Grid ColumnDefinitions="Auto, *" 
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                    
                    <!-- 当前密码 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               VerticalAlignment="Center"
                               Foreground="#546E7A"
                               FontSize="13"
                               Margin="0,6,16,6">当前密码：</TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             Classes="PasswordInput"
                             PlaceholderText="请输入当前密码..."
                             Text="{Binding CurrentPassword}"
                             PasswordChar="●"/>
                    
                    <!-- 新密码 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               VerticalAlignment="Center"
                               Foreground="#546E7A"
                               FontSize="13"
                               Margin="0,6,16,6">新密码：</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Classes="PasswordInput"
                             PlaceholderText="请输入新密码（至少6位）..."
                             Text="{Binding NewPassword}"
                             PasswordChar="●"/>
                    
                    <!-- 确认新密码 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               VerticalAlignment="Center"
                               Foreground="#546E7A"
                               FontSize="13"
                               Margin="0,6,16,6">确认密码：</TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1" 
                             Classes="PasswordInput"
                             PlaceholderText="请再次输入新密码..."
                             Text="{Binding ConfirmPassword}"
                             PasswordChar="●"/>

                    <!-- 密码强度 -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Grid.Column="0" 
                                    Classes="StrengthIndicator"
                                    Background="{Binding Strength1Color}"
                                    Margin="0,0,2,0"/>
                            <Border Grid.Column="1" 
                                    Classes="StrengthIndicator"
                                    Background="{Binding Strength2Color}"
                                    Margin="2,0,2,0"/>
                            <Border Grid.Column="2" 
                                    Classes="StrengthIndicator"
                                    Background="{Binding Strength3Color}"
                                    Margin="2,0,2,0"/>
                            <Border Grid.Column="3" 
                                    Classes="StrengthIndicator"
                                    Background="{Binding Strength4Color}"
                                    Margin="2,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding StrengthText}" 
                                   FontSize="11" 
                                   Foreground="#78909C"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 提示信息 -->
            <Border Background="{Binding MessageBackground}"
                    CornerRadius="4"
                    Padding="10"
                    IsVisible="{Binding HasMessage}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding MessageIcon}" FontSize="16"/>
                    <TextBlock Text="{Binding MessageText}"
                               FontSize="12"
                               Foreground="{Binding MessageColor}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Classes="SecondaryButton"/>
                <Button Content="确认修改" 
                        Command="{Binding SaveCommand}"
                        Classes="PrimaryButton"
                        IsEnabled="{Binding CanSave}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>