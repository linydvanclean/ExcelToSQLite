<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="750" 
             d:DesignHeight="650"
             x:Class="ExcelToSQLite.Views.ConfigEditView">
    
    <UserControl.Styles>
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PrimaryButton:disabled">
            <Setter Property="Background" Value="#A5D6A7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.InfoButton">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="15" RowDefinitions="Auto,Auto,*,Auto,Auto">
        
        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <TextBlock Text="📝 配置文件编辑"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="#1A237E"/>
            <TextBlock Text="编辑 appconfig.json 配置文件"
                       FontSize="12"
                       Foreground="#78909C"/>
        </StackPanel>
        
        <!-- 配置信息 -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" 
                           Text="📁 文件路径：" 
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding ConfigPath}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#78909C"
                           Margin="10,0,10,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" 
                        Content="🔄 重新加载"
                        Command="{Binding LoadCommand}"
                        Width="100"
                        Classes="InfoButton"/>
            </Grid>
        </Border>
        
        <!-- 编辑器 -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="5">
            <DockPanel>
                <!-- 工具栏 -->
                <StackPanel DockPanel.Dock="Top" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            Margin="0,0,0,8">
                    <Button Content="📐 格式化"
                            Command="{Binding FormatCommand}"
                            Classes="InfoButton"
                            FontSize="12"
                            Padding="8,5"/>
                    <Button Content="💾 保存"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding HasChanges}"
                            Classes="PrimaryButton"
                            FontSize="12"
                            Padding="8,5"/>
                    <Button Content="🔄 重置"
                            Command="{Binding ResetCommand}"
                            FontSize="12"
                            Padding="8,5"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{Binding StatusColor}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
                
                <!-- JSON 编辑器 - 使用 ScrollViewer 包裹 TextBox -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ConfigJson}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="18"
                             Background="#FAFAFA"
                             BorderThickness="0"
                             MinHeight="350"
                             IsEnabled="{Binding !IsLoading}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        
        <!-- 按钮区域 -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*"
              Margin="0,15,0,0">
            <Button Grid.Column="0" 
                    Content="✅ 保存"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding HasChanges}"
                    Classes="PrimaryButton"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="150"/>
            <Button Grid.Column="1" 
                    Content="❌ 取消"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Width="150"/>
        </Grid>
        
        <!-- 提示 -->
        <TextBlock Grid.Row="4"
                   Text="💡 提示：修改 JSON 配置后点击保存生效，支持格式化 JSON"
                   FontSize="11"
                   Foreground="#78909C"
                   Margin="0,10,0,0"
                   TextAlignment="Center"/>
    </Grid>
</UserControl>