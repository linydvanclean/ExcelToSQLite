<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ExcelToSQLite.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="800"
             x:Class="ExcelToSQLite.Views.AttendanceView">

    <Border Background="White" CornerRadius="12" Padding="20">
        <DockPanel>
            <!-- 底部状态消息 -->
            <Border DockPanel.Dock="Bottom"
                    Background="{Binding StatusColor}"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,10,0,0"
                    IsVisible="{Binding ShowStatus}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 主内容区域 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- ========== 标题区域 ========== -->
                    <Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="📋" FontSize="32" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="出勤记录导入"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#0D47A1"/>
                                    <TextBlock Text="支持员工刷卡记录表格式，自动解析上下班打卡记录（支持多文件批量导入）"
                                               FontSize="12"
                                               Foreground="#1565C0"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="📥 下载样表"
                                    Command="{Binding DownloadTemplateCommand}"
                                    Classes="PreviewButton"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Padding="16,8"/>
                        </Grid>
                    </Border>

                    <!-- ========== 文件选择区域 ========== -->
                    <Border Background="#F8F9FA"
                            CornerRadius="8"
                            Padding="14,12"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📁 选择文件"
                                       FontWeight="SemiBold"
                                       Foreground="#1A237E"
                                       FontSize="14"/>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="文件："
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding FilePath}"
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="2"
                                        Content="📂 浏览..."
                                        Command="{Binding SelectFileCommand}"
                                        Classes="BrowseButton"/>
                            </Grid>
                            <!-- 已选文件列表 -->
                            <ScrollViewer MaxHeight="80"
                                          IsVisible="{Binding SelectedFiles.Count, Converter={StaticResource StringToBoolConverter}}">
                                <ItemsControl ItemsSource="{Binding SelectedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="📄" FontSize="12"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#2E7D32" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="支持格式: .xlsx / .xls（支持多文件选择，列数相同的文件自动合并）"
                                           FontSize="11"
                                           Foreground="#78909C"/>
                                <TextBlock Text="💡 格式说明：工号 + 姓名 + 部门 + 每日上下班打卡时间"
                                           FontSize="11"
                                           Foreground="#1565C0"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ========== 批次选择 + 数据字典选择 ========== -->
                    <Grid ColumnDefinitions="*,*">

                        <Border Grid.Column="0"
                                Background="#FFF8E1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,6,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="📋 批次选择"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           FontSize="14"/>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="选择批次："
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Batches}"
                                              SelectedItem="{Binding SelectedBatch}"
                                              DisplayMemberBinding="{Binding Name}"
                                              Margin="0,0,8,0"/>
                                    <Button Grid.Column="2"
                                            Content="🔄"
                                            Command="{Binding RefreshBatchesCommand}"
                                            Classes="SmallButton"
                                            ToolTip.Tip="刷新批次"/>
                                </Grid>
                                <TextBlock Text="{Binding BatchInfo}"
                                           FontSize="11"
                                           Foreground="#8D6E63"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#F3E5F5"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="6,0,0,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="📚 数据字典"
                                           FontWeight="SemiBold"
                                           Foreground="#4A148C"
                                           FontSize="14"/>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="使用："
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding UseDictionary}"
                                              VerticalAlignment="Center"
                                              Margin="6,0,10,0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DataDictionaries}"
                                              SelectedItem="{Binding SelectedDictionary}"
                                              DisplayMemberBinding="{Binding Name}"
                                              Margin="0,0,8,0"
                                              IsEnabled="{Binding UseDictionary}"/>
                                    <Button Grid.Column="3"
                                            Content="🔄"
                                            Command="{Binding RefreshDictionariesCommand}"
                                            Classes="SmallButton"
                                            IsEnabled="{Binding UseDictionary}"
                                            ToolTip.Tip="刷新字典"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DictionaryInfo}"
                                               FontSize="11"
                                               Foreground="#7B1FA2"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="💡 根据字典 TableName 生成表名"
                                               FontSize="10"
                                               Foreground="#9C27B0"
                                               FontStyle="Italic"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ========== 表名设置 ========== -->
                    <Border Background="#F8F9FA"
                            CornerRadius="8"
                            Padding="14,12"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📝 表名设置"
                                       FontWeight="SemiBold"
                                       Foreground="#1A237E"
                                       FontSize="14"/>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="表名："
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TableName}"
                                         IsReadOnly="False"
                                         Background="White"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="2"
                                        Content="🔄 自动生成"
                                        Command="{Binding GenerateTableNameCommand}"
                                        Classes="PreviewButton"/>
                            </Grid>
                            <TextBlock Text="{Binding TableNameInfo}"
                                       FontSize="11"
                                       Foreground="#78909C"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TableNameValidation}"
                                       FontSize="11"
                                       Foreground="{Binding ValidationColor}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowValidation}"/>
                        </StackPanel>
                    </Border>

                    <!-- ========== 预览信息 ========== -->
                    <Border Background="#F5F5F5"
                            CornerRadius="8"
                            Padding="12"
                            IsVisible="{Binding PreviewInfo, Converter={StaticResource StringToBoolConverter}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="📊" FontSize="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding PreviewInfo}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DebugInfo}"
                                           FontSize="11"
                                           Foreground="#BDBDBD"
                                           IsVisible="{Binding DebugInfo, Converter={StaticResource StringToBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ========== 操作按钮 ========== -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="16"
                                Margin="0,4,0,0">
                        <Button Content="📤 导入到数据库"
                                Command="{Binding ImportCommand}"
                                IsEnabled="{Binding CanImport}"
                                Classes="PrimaryButton"
                                FontSize="14"
                                Padding="20,10"
                                FontWeight="Bold"/>
                        <Button Content="🗑️ 清空"
                                Command="{Binding ClearCommand}"
                                Classes="DangerButton"
                                FontSize="14"
                                Padding="20,10"
                                FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Height="4"/>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>